# Kopie als .env.production nur auf dem Server ausfüllen.
# Domain ohne https://, Pfad oder Slash. DNS muss auf den Server zeigen.
DOMAIN=spiel.example.com
# Gastspiel ist standardmäßig aktiv. false verlangt ein eingerichtetes Discord-Konto.
ENABLE_GUEST=true
# Optional: Beide Discord-Werte gemeinsam für Kontospeicherung setzen.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
