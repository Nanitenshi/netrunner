# Für lokale Tests genügt: pnpm start
PORT=5173
HOST=0.0.0.0
ENABLE_GUEST=true
# Discord später aktivieren. Secret bleibt ausschließlich auf dem Server.
# PUBLIC_URL=https://deine-domain.de
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Redirect im Discord Developer Portal: https://deine-domain.de/auth/discord/callback
# Für Veröffentlichung NODE_ENV=production und ENABLE_GUEST=false setzen.
# DATABASE_PATH=./data/nexus.sqlite
